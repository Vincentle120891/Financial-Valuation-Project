# =============================================================================
# FinGrid — Production Environment Variables
# EPYCHN-2 Hanoi VPS Deployment
# =============================================================================

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
APP_NAME=FinGrid
APP_VERSION=2.0.0

# ---------------------------------------------------------------------------
# FRONTEND BUILD (baked into Vite at build time)
# ---------------------------------------------------------------------------
VITE_API_URL=https://platform.yourdomain.com/api

# ---------------------------------------------------------------------------
# CORS (comma-separated origins)
# ---------------------------------------------------------------------------
CORS_ORIGINS=["https://platform.yourdomain.com"]

# ---------------------------------------------------------------------------
# SESSION MANAGEMENT
# ---------------------------------------------------------------------------
SESSION_TTL_HOURS=24

# SQLite cache (persistent via Docker volume at /app/data)
DATABASE_URL=sqlite:////app/data/peer_cache.db

# Optional: MongoDB for persistent sessions (uncomment when ready)
# MONGODB_URL=mongodb://mongo:27017
# MONGODB_DB=valuation_engine
# MONGODB_ENABLED=true

# ---------------------------------------------------------------------------
# API KEYS (optional — users can provide their own via frontend)
# Users bring their own keys via Step 1 modal; these are server fallbacks.
# ---------------------------------------------------------------------------

# Financial Data APIs
# ALPHA_VANTAGE_API_KEY=
# FMP_API_KEY=
# FRED_API_KEY=
# SEC_EDGAR_EMAIL=

# AI / LLM APIs (OpenRouter is primary)
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# GEMINI_API_KEY=
# QWEN_API_KEY=

# AI Model Preferences
# OPENROUTER_MODEL=openrouter/owl-alpha

# ---------------------------------------------------------------------------
# REDIS (optional — for distributed session store)
# ---------------------------------------------------------------------------
# REDIS_URL=redis://redis:6379
# REDIS_HOST=redis
# REDIS_PORT=6379

# ---------------------------------------------------------------------------
# VALUATION ENGINE DEFAULTS
# ---------------------------------------------------------------------------
DEFAULT_WACC=0.08
DEFAULT_RISK_FREE_RATE=0.04
DEFAULT_MARKET_RISK_PREMIUM=0.06
DEFAULT_TERMINAL_GROWTH_RATE=0.025
